# Neon connection string (Neon console → Connect → copy the pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# First login account, created by `npm run db:setup`
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Front Desk
